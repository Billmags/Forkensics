# Required environment variables for upload-authorize (Amendment D: R2 presign).
# This file documents key names only — no values are stored here.
# Actual values are set via Supabase dashboard → Edge Functions → Secrets
# (Phase 2a/2b) or by tools/integration-runner.sh (local test).
#
# DO NOT commit .env.local — it is git-ignored.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
